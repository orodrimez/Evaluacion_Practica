@model IEnumerable<Evaluacion_Practica.Entity.Cliente>

@{
    ViewData["Title"] = "Index";
}

<h1>Clientes</h1>

<p>
    <form>
    <button class="btn btn-success" asp-controller="Clientes" asp-action="Create" type="submit">Nuevo</button>
    </form>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                Edad
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Celular)
            </th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th><i class="bi bi-pencil-square"></i></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @(DateTime.Now.Year - Convert.ToDateTime(item.FechaNacimiento).Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Celular)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
}
    </tbody>
</table>
